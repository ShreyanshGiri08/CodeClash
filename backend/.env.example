# ── Database ──
# Neon PostgreSQL connection string (get from https://neon.tech console)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── Auth ──
JWT_SECRET=your-super-secret-key-change-this-in-production

# ── CORS ──
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173

# ── Caching (optional, has sensible defaults) ──
# PROBLEM_CACHE_TTL=3600
# PROBLEMSET_CACHE_TTL=600

# ── Matchmaking (optional) ──
# MATCHMAKING_TIMEOUT=120
# MATCHMAKING_INITIAL_BAND=100
# MATCHMAKING_MAX_BAND=500

# ── Rate Limiting (optional) ──
# RATE_LIMIT_QUEUE_PER_MINUTE=5
# RATE_LIMIT_CHECK_PER_MINUTE=15
